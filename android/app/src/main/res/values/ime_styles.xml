<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ImeKeyStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/ime_key_height</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:background">@drawable/key_background</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="ImeSpecialKeyStyle" parent="ImeKeyStyle">
        <item name="android:background">@drawable/key_special_background</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ImeSpaceKeyStyle" parent="ImeKeyStyle">
        <item name="android:background">@drawable/key_space_background</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
